# ==============================================================================
# Production ANPR System Configuration
# ==============================================================================

# Hardware & Compute Device
# Options: "auto" (probes CUDA GPU -> MPS -> CPU), "cuda", "cuda:0", "cpu"
DEVICE=auto

# Video Source & Camera
# 0 for USB webcam, file path for video (e.g. video.mp4), or "synthetic" for simulated feed
CAMERA_SOURCE=0
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_RECONNECT_MAX_ATTEMPTS=10

# Vision Models & Runtime Backend
# 'onnx' = lightweight ONNX Runtime (DirectML GPU + CPU, no PyTorch/CUDA required)
# 'pytorch' = original Ultralytics PyTorch models (development/parity benchmarking)
INFERENCE_BACKEND=onnx
PLATE_ONNX_MODEL_PATH=models/license_plate_detector.onnx
VEHICLE_ONNX_MODEL_PATH=models/vehicle_detector.onnx
YOLO_MODEL_PATH=models/license_plate_detector.pt
VEHICLE_MODEL_PATH=models/vehicle_detector.pt

# Computer Vision Thresholds
DETECTION_CONFIDENCE=0.25
VEHICLE_CONFIDENCE=0.35
IOU_THRESHOLD=0.45
FRAME_SKIP=1
OCR_CONFIDENCE=0.58

# Event-Triggered Video Clip Recording & Deferred Processing
CLIP_RECORDING_ENABLED=true
KEEP_ALL_CLIPS=true
RECORD_PRE_ROLL_SECONDS=0.8
RECORD_POST_ROLL_SECONDS=1.5
RECORD_MAX_DURATION=4.5
CLIP_TOP_K_CROPS=12
CLIP_DETECT_IMGSZ=960
NOTIFICATION_ATTACH_PHOTO=true

# State Management & Anti-Duplicate Controls
RECOGNITION_COOLDOWN=60
RECOGNITION_WINDOW=5
EVENT_STRATEGY=toggle
VIRTUAL_LINE_Y=0.55

# Database Configuration (SQLite with WAL Mode)
DATABASE_URL=sqlite:///./vehicle_logs.db
DATABASE_TIMEOUT=30.0
DATABASE_WAL_MODE=true

# Mobile Push Notifications (ntfy.sh)
NOTIFICATIONS_ENABLED=true
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=anpr_vehicle_events_demo
NTFY_TOKEN=
NTFY_TIMEOUT=6.0

# Archiving & Retention
IMAGE_RETENTION_DAYS=90

# API & Security
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
JWT_SECRET_KEY=anpr-production-super-secret-key-change-in-env-2026

# Disclosed Licensing & Periodic Online Verification (see LICENSE_NOTICE.txt)
# Set LICENSE_CHECK_ENABLED=true and assign a valid LICENSE_KEY for packaged releases.
LICENSE_CHECK_ENABLED=false
LICENSE_SERVER_URL=https://my-license-server.example.com/api/v1/validate
LICENSE_KEY=
LICENSE_SUPPORT_CONTACT=support@yourcompany.example.com
LICENSE_GRACE_HOURS=72
LICENSE_TIMEOUT_SECONDS=6.0
LICENSE_MAX_RETRIES=3
LICENSE_RECHECK_INTERVAL_SECONDS=3600

